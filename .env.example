# SQLite 数据库文件路径（相对仓库根目录，或使用绝对路径）
DATABASE_PATH=.data/chris-hub.sqlite

# --- OSS（本地测试/阶段 C 使用；复制到 .env.local 填写真实值，不要提交） ---
# 地域短名，如新加坡 ap-southeast-1；脚本会自动拼出 oss-ap-southeast-1.aliyuncs.com
OSS_REGION=ap-southeast-1
# 测试桶名（生产环境使用独立桶，与测试桶隔离）
OSS_BUCKET=
# RAM 子账号 AccessKey（测试用最小权限；生产使用 STS 临时凭证，长期密钥不下发浏览器）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 生产环境图片 CDN 域名，例如 https://assets.example.com；本地测试留空
# ASSET_BASE_URL=
